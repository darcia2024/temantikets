# Salin ke .env.local lalu isi. Di Vercel, isi lewat Project Settings > Environment Variables.

# URL publik aplikasi (dipakai di link WA, kwitansi, Lacak Order)
APP_URL=http://localhost:3000

# Rahasia untuk cookie login owner (min. 32 karakter acak)
SESSION_SECRET=
# Password login owner di /login
ADMIN_PASSWORD=
# Token rahasia untuk link papan Mandub: APP_URL/mandub/<MANDUB_TOKEN> (min. 16 karakter)
MANDUB_TOKEN=
# Dipakai Vercel Cron untuk memanggil /api/cron/reminders
CRON_SECRET=

# Push notification ke HP owner. Buat dengan: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Origin yang boleh memanggil /api/lacak dari situs VOA
LACAK_ALLOWED_ORIGINS=https://voatemantiket.site,https://www.voatemantiket.site

# Postgres produksi di Neon. Kosong = PGlite lokal di .data/
# Kalau Neon dipasang lewat Vercel (Storage > Neon), dua variabel ini terisi otomatis.
# DATABASE_URL          = connection string *pooled* (host berisi "-pooler"), dipakai app
# DATABASE_URL_UNPOOLED = connection string *direct*, dipakai `npm run db:migrate`
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Opsional: jumlah koneksi per instance serverless (default 3)
# DB_POOL_MAX=3

# Nomor WA owner (format 62...), dipakai tombol 'Lanjut chat' setelah customer kirim request
OWNER_WA=
